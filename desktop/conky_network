alignment top_left

background yes
use_xft yes
xftfont 123:size=10
xftalpha 0.1
update_interval 1
total_run_times 0
own_window yes
own_window_type desktop
own_window_transparent no
own_window_class conky-semi
own_window_hints undecorated,below,sticky,skip_taskbar,skip_pager
own_window_argb_visual yes
own_window_argb_value 0
double_buffer yes
minimum_size 280 0
draw_shades no
draw_outline no
draw_borders no
draw_graph_borders yes
default_color 7F8786
default_shade_color DimGray
default_outline_color DimGray

gap_x 20
gap_y 20

stippled_borders 3
border_inner_margin 4
border_width 5

no_buffers no
uppercase no
cpu_avg_samples 8
#net_avg_samples 1
#override_utf8_locale yes
use_spacer right
text_buffer_size 256

TEXT
NETWORK ${hr 2}

SSID: $alignr ${wireless_essid wlp2s0}
Public IP $alignr${exec cat /home/edouard/.config/ip}
Local IP $alignr ${addr wlp2s0}
WiFi Signal ${alignr}${wireless_link_bar 6, 140 wlp2s0}

Up $alignr${upspeed wlp2s0}
${upspeedgraph wlp2s0 20,280 DimGray DimGray}
Down  $alignr${downspeed wlp2s0}
${downspeedgraph wlp2s0 20,280 DimGray DimGray} 
Uploaded: $alignr ${totalup wlp2s0} Downloaded: $alignr ${totaldown wlp2s0}

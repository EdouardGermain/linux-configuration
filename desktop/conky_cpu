alignment top_left

background yes
use_xft yes
xftfont GE Inspira:size=12
xftalpha 0.1
update_interval 1
total_run_times 0
own_window yes
own_window_type desktop
own_window_transparent no
own_window_class conky-semi
own_window_hints undecorated,below,sticky,skip_taskbar,skip_pager
own_window_argb_visual yes
own_window_argb_value 0
double_buffer yes
minimum_size 280 0
draw_shades no
draw_outline no
draw_borders no
draw_graph_borders yes
default_color 7F8786
default_shade_color DimGray
default_outline_color DimGray

gap_x 20
gap_y 275

stippled_borders 3
border_inner_margin 4
border_width 5

no_buffers no
uppercase no
cpu_avg_samples 8
#net_avg_samples 1
#override_utf8_locale yes
use_spacer right
text_buffer_size 256

TEXT
PROCESSORS ${hr 2}
CPU usage : $alignr ${cpu}%
Temperature : $alignr${hwmon 3 temp 1}°C

Core 1 $alignr${cpu cpu1}%
${cpubar cpu1}
Core 2 $alignr${cpu cpu2}%
${cpubar cpu2}
Core 3 $alignr${cpu cpu3}%
${cpubar cpu3}
Core 4 $alignr${cpu cpu4}%
${cpubar cpu4}
Core 5 $alignr${cpu cpu5}%
${cpubar cpu5}
Core 6 $alignr${cpu cpu6}%
${cpubar cpu6}
Core 7 $alignr${cpu cpu7}%
${cpubar cpu7}
Core 8 $alignr${cpu cpu8}%
${cpubar cpu8}
